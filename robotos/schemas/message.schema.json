{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageStreamEnvelope",
  "type": "object",
  "required": ["type", "topic", "correlation_id", "payload", "ts"],
  "properties": {
    "type": {"enum": ["Event", "Request", "Proposal", "Decision", "Override", "Escalation"]},
    "topic": {"type": "string"},
    "severity": {"type": "string"},
    "session_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "trace_id": {"type": "string"},
    "payload": {"type": "object"},
    "ts": {"type": "integer"}
  }
}
