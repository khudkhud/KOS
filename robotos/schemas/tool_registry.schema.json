{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolRegistryEntry",
  "type": "object",
  "required": ["tool", "required_resources", "capability", "risk_class"],
  "properties": {
    "tool": {"type": "string"},
    "dds_action": {"type": "string"},
    "required_resources": {"type": "array", "items": {"type": "string"}},
    "capability": {"type": "string"},
    "risk_class": {"enum": ["SAFE", "CONFIRM", "FORBIDDEN"]},
    "cancel_grace_ms": {"type": "integer"},
    "timeout_default_ms": {"type": "integer"}
  }
}
